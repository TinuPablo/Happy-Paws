# Copiá este archivo como .env y completá los valores reales.
# Nunca subas el .env a git ni pegues sus valores en un chat.

# --- Base de datos y sesión ---
DATABASE_URL=""
SESSION_SECRET=""

# --- Cloudinary (fotos/video) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (recuperación de contraseña, invitaciones, avisos de solicitud) ---
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Correo (Gmail SMTP con contraseña de aplicación) ---
SMTP_USER=""
SMTP_PASS=""
# Casilla que recibe solicitudes de protectoras y reportes
MAIL_ADMIN=""
APP_URL="http://localhost:3000"

# --- Captcha (Cloudflare Turnstile) ---
# Claves de prueba que siempre pasan (solo desarrollo):
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
